      "D3_agency=law_without_will",
      "D3_agency=reciprocal_dependency",
      "D4_cosmic_function=no_function_attributed",
      "D5_universe_relationship=scale_not_claimed",
      "D5_universe_relationship=wholly_other",
      "D6_temporal_nature=linear_once"
    ],
    "minimum_tier_if_only_one_coder_is_available": "code the 11 census strata first: those are the values with the least evidence, and they are the rows a single analyst's reading is least likely to have got right"
  },
  "recall_probe": {
    "why_it_was_added": "the three detection strata all draw from propositions that already carry a machine record, so they can estimate precision and cannot estimate recall: a sample of hits contains no misses. not_yet_instrumented is a declared gap on a named value, not an estimate of what the detector walked past.",
    "universe": {
      "propositions_in_universe": 1028478,
      "eligible_passages_scanned": 23385,
      "hit_by_the_machine": 36334,
      "propositions_with_any_machine_record": 36775,
      "of_which_the_machine_asserted_nothing": 441,
      "records_excluded_as_non_detections": 519,
      "of_which_not_yet_instrumented": 379,
      "of_which_requires_human_disambiguation": 140,
      "no_record_in_universe": 992144,
      "of_which_cue_positive": 47311,
      "of_which_cue_negative": 944833
    },
    "strata": {
      "no_candidate_uncued": {
        "population": 944833,
        "sampled": 900,
        "inclusion_probability": 0.000952549286,
        "sampling_weight": 1049.8144,
        "draw": "simple random sample without replacement over the whole stratum, so the inclusion probability is n/N exactly and needs no approximation"
      },
      "no_candidate_cue_positive": {
        "population": 47311,
        "sampled": 600,
        "inclusion_probability": 0.012682040118,
        "sampling_weight": 78.8517,
        "draw": "simple random sample without replacement over the whole stratum, so the inclusion probability is n/N exactly and needs no approximation"
      }
    },
    "rows_added": {
      "no_candidate_uncued": 900,
      "no_candidate_cue_positive": 600
    },
    "segmentation": "the detector's own normalise -> windows_of -> propositions_of, so the probe population is the population the detector claims to cover",
    "cue_list": {
      "file": "config/recall_probe_cues.json",
      "cues_operative": 111,
      "cues_retired_ambiguous": 6,
      "sha256": "bacde4ff9a7cab6f14cda9e091ed0634880c2eb95c0f2d05efde22aa813de4b5",
      "status": "a sampling instruction; a cue never produces an attestation, a value assignment or a doctrinal count"
    },
    "estimator": {
      "detected_v": "propositions carrying an `assertion_state: candidate` record for value v, counted over the whole corpus, not over the packet",
      "what_is_not_a_detection": "a `not_yet_instrumented` record names a value this detector declares it cannot detect, and a `candidate_requires_human_disambiguation` record names a value it refused to choose. Neither is a detection: counting them gave values with no detector a nonzero numerator, and counting their propositions as hits removed them from the frame where a miss could be found. Both are still sampled, in the candidate strata, so a human read can validate them.",
      "estimated_misses_v": "the sum of sampling_weight over probe rows a human coded as carrying value v -- Horvitz-Thompson, one weight per drawn proposition",
      "recall_hat_v": "detected_v / (detected_v + estimated_misses_v)",
      "pooled_across_both_probe_strata": true,
      "why_two_strata_not_one": "misses concentrate where the text names a divinity, so a single uniform draw would spend almost all of its rows on propositions with nothing in them and leave the dense region unmeasured; stratifying and weighting keeps the pooled estimate design-unbiased over the whole no-record universe while still looking hard at the part where a miss is likely",
      "precision_still_comes_from": "the machine_candidate rows; probe rows carry no machine value to be wrong about"
    },
    "what_this_still_cannot_measure": [
      "a divine proposition no human reader can identify from the proposition and its window either",
      "propositions the segmentation itself never produced: a claim that spans two segments, or one the window splitter merged away, is outside the universe this probe draws from",
      "any value whose detector gap is structural rather than lexical, except insofar as a human coding a probe row happens to name it"
    ]
  },
