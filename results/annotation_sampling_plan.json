{
  "instrument": "annotation packet v3.1",
  "unit_of_analysis": "one proposition about an identified divine referent, with its utterance window carried as context",
  "sizing": {
    "propositions": 6199,
    "machine_candidate_rows": 4699,
    "recall_probe_rows": 1500,
    "judgments_per_coder": 74388,
    "why_this_size": "the binding constraint is a second coder, not more data; the packet is sized so every value stratum carries enough rows to put a usable interval on its precision, rare strata are taken as a census, and the two no-candidate strata are sized to bound the miss rate rather than to exhaust it",
    "worst_case_95pct_margin_on_a_value_precision_at_target": "±0.124 at n=60 (p=0.5, normal approximation)",
    "strata_taken_as_census": 11,
    "census_strata": [
      "D1_ontological_category=deified_mortal",
      "D1_ontological_category=unknowable_or_conceptless",
      "D2a_acknowledged_population=few_or_several",
      "D2c_worship_exclusivity=devotion_to_others_permitted",
